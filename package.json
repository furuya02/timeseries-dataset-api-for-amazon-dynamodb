{
  "name": "timeseries-dataset-api-for-amazon-dynamodb",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "cdk-synth": "pnpm --dir cdk exec cdk synth",
    "cdk-deploy": "pnpm --dir cdk exec cdk deploy",
    "cdk-destroy": "pnpm --dir cdk exec cdk destroy",
    "seed": "pnpm --dir scripts exec tsx seed.ts",
    "init-dataset": "pnpm --dir scripts exec tsx init-dataset.ts",
    "check": "pnpm --dir scripts exec tsx check.ts",
    "grafana-config": "pnpm --dir scripts exec tsx grafana-config.ts",
    "grafana-up": "docker compose -f grafana/docker-compose.yml up -d",
    "grafana-down": "docker compose -f grafana/docker-compose.yml down",
    "local-api": "pnpm --dir scripts exec tsx local-api.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --dir cdk test:integration",
    "coverage": "pnpm --dir cdk coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.24.0"
}
